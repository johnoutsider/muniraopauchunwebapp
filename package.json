{
  "name": "linguaecon-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-based professional English platform for economics students (DSc research MVP)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "seed": "tsx scripts/seed.ts",
    "seed:items": "tsx scripts/generate-items.ts",
    "corpus:build": "tsx scripts/build-corpus.ts",
    "users:import": "tsx scripts/import-users.ts",
    "emulators": "npx firebase emulators:start --only auth,firestore,storage",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:claims": "tsx scripts/set-claims.ts",
    "research:export": "tsx scripts/export-research.ts",
    "lint:fix": "eslint . --fix",
    "firebase:bootstrap": "tsx scripts/firebase-bootstrap.ts",
    "firebase:deploy": "npx firebase deploy --only firestore:rules,firestore:indexes,storage,functions"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
