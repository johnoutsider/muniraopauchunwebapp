####################################################################
# LinguaEcon AI — muhit o'zgaruvchilari (PLAN.md 12-bo'lim)
#
# Nusxa oling:  cp .env.example .env.local
# `.env.local` hech qachon git'ga tushmaydi (.gitignore).
#
# Belgilar:
#   [MAJBURIY]  — lokal ishlab chiqish uchun ham kerak
#   [IXTIYORIY] — bo'lmasa ham `pnpm dev` ishlaydi, funksiya o'chib turadi
#   [PROD]      — faqat Vercel preview/production uchun
####################################################################


# ------------------------------------------------------------------
# 1. Firebase — klient (brauzerda ko'rinadi, maxfiy emas)
#    Qayerdan: Firebase Console → Project settings → General →
#    "Your apps" → Web app → SDK setup and configuration → Config.
#    Dev uchun `linguaecon-dev` loyihasini, prod uchun `linguaecon-prod`.
# ------------------------------------------------------------------
# [MAJBURIY]
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=linguaecon-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=linguaecon-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=linguaecon-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# App Check (reCAPTCHA Enterprise) sayt kaliti.
# Qayerdan: Firebase Console → App Check → Apps → Web → reCAPTCHA Enterprise.
# [IXTIYORIY lokal] / [PROD majburiy] — bo'sh bo'lsa App Check o'chiriladi.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# App Check debug tokeni — faqat lokal brauzerda emulator/dev uchun.
# Qayerdan: brauzer konsolida App Check birinchi marta ishga tushganda chiqadi.
# [IXTIYORIY]
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=


# ------------------------------------------------------------------
# 2. Firebase — server (Admin SDK). MAXFIY.
#    Qayerdan: Firebase Console → Project settings → Service accounts →
#    "Generate new private key" → JSON fayl yuklanadi. Uni base64 qiling:
#      Linux/macOS:  base64 -w0 serviceAccount.json
#      Windows PS:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
#    JSON faylni repoga QO'YMANG (.gitignore'da serviceAccount*.json bor).
# ------------------------------------------------------------------
# [MAJBURIY] (emulator bilan ishlasangiz ham server kodi shu orqali ulanadi)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Emulatorga ulanish (lokal). `pnpm emulators` ishga tushganda 1 qiling.
# [IXTIYORIY]
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=0
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199


# ------------------------------------------------------------------
# 4. Claude API (matnli AI: tutor, feedback, mashq generatsiya)
#    Qayerdan: https://console.anthropic.com → API Keys → Create Key.
#    Kalitga oylik limit qo'ying (PLAN 16 — xarajat nazorati).
#    Kalitsiz: AI sahifalari "AI mavjud emas" holatini ko'rsatadi.
# ------------------------------------------------------------------
# [IXTIYORIY lokal] / [PROD majburiy]
ANTHROPIC_API_KEY=

# Model nomlari feature flag sifatida (Sonnet ↔ Haiku almashtirish — PLAN 7.4)
# [IXTIYORIY]
AI_MODEL_MAIN=claude-sonnet-4-5
AI_MODEL_FAST=claude-haiku-4-5-20251001


# ------------------------------------------------------------------
# 5. Azure AI Speech (talaffuz baholash, STT, TTS)
#    Qayerdan: portal.azure.com → Create resource → "Speech service" →
#    region `westeurope` yoki `germanywestcentral` → Keys and Endpoint → KEY 1.
#    Kalitsiz: Speaking Lab audio yozadi, lekin baholamaydi.
# ------------------------------------------------------------------
# [IXTIYORIY lokal] / [PROD majburiy]
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=germanywestcentral

# Zaxira STT (Azure ishlamasa) — PLAN 1.3
# [IXTIYORIY]
OPENAI_API_KEY=




# ------------------------------------------------------------------
# 7. Cron himoyasi
#    Vercel Cron chaqiruvlari `Authorization: Bearer $CRON_SECRET` bilan keladi.
#    Qayerdan: o'zingiz generatsiya qilasiz (openssl rand -hex 32) va
#    Vercel → Settings → Environment Variables ga yozasiz.
# ------------------------------------------------------------------
# [PROD majburiy] / lokal: ixtiyoriy (route qo'lda chaqirilganda kerak)
CRON_SECRET=


# ------------------------------------------------------------------
# 8. Email (bildirishnomalar) — Firebase Auth verifikatsiya/parol tiklashdan tashqari
#    Qayerdan: resend.com → API Keys.
# ------------------------------------------------------------------
# [IXTIYORIY]
RESEND_API_KEY=
RESEND_FROM_EMAIL=LinguaEcon <no-reply@linguaecon.uz>


# ------------------------------------------------------------------
# 9. Monitoring (Sentry)
#    Qayerdan: sentry.io → Projects → linguaecon → Settings → Client Keys (DSN).
# ------------------------------------------------------------------
# [IXTIYORIY]
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# ------------------------------------------------------------------
# 10. Ilova manzili va muhit
#     Lokal: http://localhost:3000
#     Preview: Vercel avtomatik beradigan URL
#     Prod: https://linguaecon.uz
# ------------------------------------------------------------------
# [MAJBURIY]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# `development` | `preview` | `production` — feature flag va log darajasi uchun.
# [IXTIYORIY]
NEXT_PUBLIC_ENV=development
